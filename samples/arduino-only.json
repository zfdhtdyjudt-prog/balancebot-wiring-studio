  "wires": [
    {
      "from": "battery_1.B+",
      "to": "power_1.IN",
      "label": "3S B+ to main switch",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "power_1.OUT",
      "to": "driver_1.VMS/12V",
      "label": "11.1–12.6V motor rail",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "battery_1.B-",
      "to": "driver_1.GND",
      "label": "common ground",
      "signal": "ground",
      "color": "ground"
    },
    {
      "from": "driver_1.5V",
      "to": "arduino_1.5V",
      "label": "regulated 5V from L298N jumper",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "driver_1.GND",
      "to": "arduino_1.GND",
      "label": "common ground",
      "signal": "ground",
      "color": "ground"
    },
    {
      "from": "arduino_1.A4",
      "to": "mpu_1.SDA",
      "label": "I2C SDA",
      "signal": "i2c",
      "color": "i2c"
    },
    {
      "from": "arduino_1.A5",
      "to": "mpu_1.SCL",
      "label": "I2C SCL",
      "signal": "i2c",
      "color": "i2c"
    },
    {
      "from": "arduino_1.5V",
      "to": "mpu_1.VCC",
      "label": "MPU VCC",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "arduino_1.GND",
      "to": "mpu_1.GND",
      "label": "MPU ground",
      "signal": "ground",
      "color": "ground"
    },
    {
      "from": "arduino_1.A0",
      "to": "sonar_1.TRIG",
      "label": "TRIG",
      "signal": "sensor",
      "color": "sensor"
    },
    {
      "from": "arduino_1.A1",
      "to": "sonar_1.ECHO",
      "label": "ECHO 5V",
      "signal": "sensor",
      "color": "sensor"
    },
    {
      "from": "arduino_1.A2",
      "to": "pot_1.SIG/WIPER",
      "label": "volume analog input",
      "signal": "sensor",
      "color": "sensor"
    },
    {
      "from": "arduino_1.5V",
      "to": "pot_1.VCC",
      "label": "pot supply",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "arduino_1.GND",
      "to": "pot_1.GND",
      "label": "pot ground",
      "signal": "ground",
      "color": "ground"
    },
    {
      "from": "arduino_1.D3",
      "to": "buzzer_1.SIG/PWM",
      "label": "buzzer PWM",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "buzzer_1.GND",
      "to": "arduino_1.GND",
      "label": "buzzer return",
      "signal": "ground",
      "color": "ground"
    },
    {
      "from": "arduino_1.D5",
      "to": "driver_1.ENA",
      "label": "left PWM",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "arduino_1.D6",
      "to": "driver_1.IN1",
      "label": "left direction A",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "arduino_1.D7",
      "to": "driver_1.IN2",
      "label": "left direction B",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "arduino_1.D9",
      "to": "driver_1.IN3",
      "label": "right direction A",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "arduino_1.D10",
      "to": "driver_1.IN4",
      "label": "right direction B",
      "signal": "control",
      "color": "control"
    },
    {
      "from": "driver_1.OUT1",
      "to": "motor_l.M+",
      "label": "left motor +",
      "signal": "motor",
      "color": "motor"
    },
    {
      "from": "driver_1.OUT2",
      "to": "motor_l.M-",
      "label": "left motor -",
      "signal": "motor",
      "color": "motor"
    },
    {
      "from": "driver_1.OUT3",
      "to": "motor_r.M+",
      "label": "right motor +",
      "signal": "motor",
      "color": "motor"
    },
    {
      "from": "driver_1.OUT4",
      "to": "motor_r.M-",
      "label": "right motor -",
      "signal": "motor",
      "color": "motor"
    },
    {
      "from": "battery_1.B+",
      "to": "cap_1.+",
      "label": "bulk smoothing capacitor +",
      "signal": "power",
      "color": "power"
    },
    {
      "from": "battery_1.B-",
      "to": "cap_1.-",
      "label": "bulk smoothing capacitor -",
      "signal": "ground",
      "color": "ground"
    }
  ],
  "settings": {
    "showPinNumbers": true,
    "showLabels": true,
    "showElectricalWarnings": true,
    "grid": 24,
    "powerSystem": "3S_18650",
    "sharedGround": true
  }
}
